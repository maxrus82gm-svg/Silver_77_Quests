<types>
	<type name="File_Name">
        <Customisable_Zombies_List 		File_Name = "PvZmoD_CustomisableZombies_Characteristics.xml"/>	<!-- Настраиваемый список зомби, не забудьте расширение .xml -->
    </type>
	
	<type name="Features_Activation">
        <Disable_All_Features	 						Day = "0"	Night = "0"/>	<!-- [0 или 1] Это отключит все функции мода. -->
        <Zombies_Health_Activated 						Day = "1"	Night = "1"/>	<!-- [0 или 1] Включить или выключить Здоровье зомби -->
        <Zombies_Resistance_Activated 					Day = "1"	Night = "1"/>	<!-- [0 или 1] Включить или выключить Сопротивление зомби -->
        <Zombies_Speed_Activated						Day = "1"	Night = "1"/>	<!-- [0 или 1] Включить или выключить Скорость зомби -->
        <Zombies_CrawlControl_Activated					Day = "1"	Night = "1"/>	<!-- [0 или 1] Включить или выключить Контроль зомби -->
        <Zombies_Strenght_Activated	 					Day = "1"	Night = "1"/>	<!-- [0 или 1] Включить или выключить Сила зомби -->
		<Zombies_Vision_Activated						Day = "1" 	Night = "1" WithBloodyHands="1" WithSpecialMask="1" MiniMumRatioDistance="1"/> <!-- [0 или 1] Включить или выключить дальности зрения зомби (WithBloodyHands - если у игрока окровавленные руки // WithSpecialMask - Когда игрок носит одну из масок, коэффициент «WithSpecialMask» из файла характеристик применяется к расстоянию обзора зомби) -->
        <Player_Fist_Fighting_Activated 				Day = "1"	Night = "1"/>	<!-- [0 или 1] Включить или выключить Кулачный бой игрока -->
		<Zombies_Hit_Players_On_Obstacles_Activated 	Day = "0"	Night = "0"/>	<!-- [0 или 1] Зомби бьют игроков за препятствиями --> 
	</type>
	
	<type name="Zombies_Caracteristics">
        <Zombies_Health_Ratio		Day	= "1.0"	Night = "1.0"/>	<!-- [От десятичного числа от 0,0 до бесконечности] Соотношение (%) применяется к здоровью всех зомби -->
        <Zombies_Strength_Ratio		Day	= "2.0"	Night = "2.0"/> <!-- Дамаг крови,стамины. Кроме вероятности кровотечения [от 0,0 до бесконечности] Соотношение (%) применяется ко всем зомби -->
        <Zombies_Speed_Ratio		Day	= "1.2"	Night = "0.7"/> <!-- [От десятичного числа от 0,0 до бесконечности] Соотношение (%) применяется ко всем минимальной и максимальной скорости зомби. -->
	</type>
	
    <type name="Players_Caracteristics">
        <Maximum_Number_Of_Bleeding_Sources_From_Zombies_Combat			Value = "3"	/>          <!-- Это максимальное количество источников кровотечения от зомби. Не включает кровотечение из лестниц или испорченной обуви. -->
        <Shoes_Degradation_When_Hit_By_Crawling_Zombie					Value = "5" />			<!-- [Десятичные от 0.0 до бесконечности] Ползучие зомби повреждают обувь игрока. Увеличьте его, если хотите усложнить задачу -->
        <Fist_Fighting	Gloves_Degradation_Speed_When_Fist_Fighting				= "0.6"		/>  <!-- [Десятичные от 0.0 до бесконечности] Перчатки - скорость износа при драке кулаками. Увеличьте его, если хотите усложнить задачу (Тактические перчатки имеют например 100.0 hp) -->
        <Fist_Fighting 	Bleeding_Chance_If_Fist_Fighting_Without_Gloves 		= "0.1"	/>  <!-- [Десятичные от 0.0 до 1.0] Вероятность кровотечения при кулачном бою без перчаток -->
        <Fist_Fighting	Player_Dammage_If_Fist_Fighting_Without_Gloves			= "0.5"		/>  <!-- [Десятичные от 0.0 до 100.0] Урон игроку, если кулачный бой без перчаток (Максимальное здоровье игрока составляет 100.0 hp) -->
        <Fist_Fighting	Player_Health_Limite_To_Take_Dammage_From_Fist_Fighting	= "30.0"	/>  <!-- [Десятичные от 0.0 до 100.0] Предел здоровья игрока, чтобы получить урон от кулачного боя -->
        <Special_Mask_To_Hide_From_Zombies	List = ""	/>	<!-- Специальная маска, чтобы спрятаться от зомби (без пробелов, используйте запятую между масками) -->
		  <!-- Эта функция позволяет игроку поражать несколько зомби, когда он выполняет тяжелую атаку. (Удар с разбега)-->
		<Multi_Hits_On_Heavy_Attack			Radius 					= "1.2"	/>	<!-- [Десятичные от 0.0 до бесконечности] Значение «радиуса» - это радиус (в метрах) вокруг зомби, в который впервые попадает удар. (0.0 => Отключите функцию / слишком высокое значение может вызвать проблемы с производительностью) --> 
		<Multi_Hits_On_Heavy_Attack			Dammage_Ratio 			= "0.5"	/>	<!-- [Десятичные от 0.0 до 1.0] (вы можете установить > 1,0 но я не думаю, что это имеет смысл с точки зрения игрового процесса) -->
		<Multi_Hits_On_Heavy_Attack			Min_Dammage_To_Activate	= "20"	/>	<!-- [Десятичные от 0.0 до бесконечности] это значение не позволяет использовать эту функцию, когда игрок сражается с большинством предметов, не являющихся оружием. --> 
		<Multi_Hits_On_Heavy_Attack			Stamina_Bonus			= "2"	/>	<!-- [Десятичные от 0.0 до бесконечности] Когда игрок поражает многих зомби сильной атакой, он восстанавливает небольшое количество выносливости за каждое попадание зомби (не за первое) -->   
    </type>
	      <!-- Возможно, вы заметили, что ванильное ночное расписание не совсем соответствует тому, что мы можем назвать ночью в реальной жизни.
		       Ванильная система считает, что наступила ночь, когда солнце скрывается за горизонтом, даже если свет все еще яркий.
		       Эта функция позволяет изменять время начала и конца ночи.
		       Помните, что это повлияет только на систему ночного зомби этого мода, он не изменит ускорение ванильного времени.-->
	<type name="Night_Management">
        <OverRide_Vanilla_Night_Time	Activated 	= "1"		/> <!-- Установите значение 1, чтобы использовать индивидуальные ночные расписания (0, чтобы сохранить обычные (ВАНИЛЬНЫЕ) ночные расписания) / -1: Нет ночной конфигурации (всегда используется дневная конфигурация зомби) -->
        <Night_Beginning				Time 		= "20:00"	/> <!-- Установите время начала ночи (24 часа) -->
        <Night_End						Time 		= "05:00"	/> <!-- Установите время окончания ночи (24 часа) -->
    </type>		
		  <!-- Каждый раз, когда игрок сбивает зомби машиной (если скорость машины выше Speed_Minimum), радиатор машины получает повреждения.
		       Учтите, что радиатор получит повреждения, даже если зомби ударится задней частью машины.-->
	<type name="Damages_To_Vehicles_Radiator_When_Cruching_Zombies">
 		<Damages_To_Vehicles		Activated	 			= "1"		/>	<!-- 0 для отключения / 1 для активации этой функции -->
		<Damages_To_Vehicles		Vehicle_Type_Resistance	= "DefaultCars:200,ExpansionVodnik:200,ExpansionBus:200"/>	<!-- Класс техники:ХП радиатора (Добавление без пробелов, внимательно посмотрите на линейную структуру, если хотите добавить автомобили) -->
		<Damages_To_Vehicles		Damages_Per_Impact	 	= "0.3"		/>	<!-- десятичный [от 0,0 до бесконечности] Повреждения, полученные радиатором автомобиля при каждом столкновении с зомби -->
		<Damages_To_Vehicles		Timer_Between_Impacts	= "7"		/>	<!-- Целое число [от 1 до бесконечности] (секунды) (никогда не ниже 1) Это сделано для того, чтобы радиатор не получил одновременного множественного удара. -->
		<Damages_To_Vehicles		Speed_Minimum	 		= "30"		/>	<!-- Целое число [от 1 до бесконечности] (км/ч) (никогда не ниже 1) Это необходимо для предотвращения повреждения радиатора при медленном движении автомобиля. -->
		<Damages_To_Vehicles		Speed_Multiplier	 	= "0.01"	/>	<!-- десятичный [от 0,0 до бесконечности] Если установлено значение выше нуля, то чем быстрее транспортное средство движется, тем больше повреждений он получит при попадании в зомби. Например, если установлено значение «0,01», радиатор получит на 1,0 очко повреждения больше, если скорость составляет 100 км / ч (0,01 * 100 = 1,0). -->
    </type>	
	
